{
  "manifest_version": 3,
  "name": "LEESFACT 구매내역 연동",
  "version": "1.4.0",
  "description": "LEESFACT 재고관리 — 무신사·TUNE 구매내역, 스마트스토어 매출·주문·상품·정산·문의, KREAM 판매내역 조회 (읽기 전용)",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.musinsa.com/*",
    "https://lkk8060.github.io/*",
    "https://tune.kr/*",
    "https://api.commerce.naver.com/*",
    "https://kream.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lkk8060.github.io/LEESFACT/*",
        "https://lkk8060.github.io/leesfact/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tune.kr/*"
      ],
      "js": [
        "tune_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tune.kr/*"
      ],
      "js": [
        "tune_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kream.co.kr/my/*"
      ],
      "js": [
        "kream_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}